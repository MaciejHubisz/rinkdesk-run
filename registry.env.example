# GitHub credentials for the private common/ submodule and the ghcr.io images.
#
# Copy to registry.env (gitignored) and fill in. Read by the run scripts, so a
# fresh host clones the submodule and pulls the private images with no prompts.
#
#   cp registry.env.example registry.env
#   chmod 600 registry.env
#
# Create a classic token with the repo and read:packages scopes in a browser
# (GitHub → Settings → Developer settings → Personal access tokens). It is a
# token, not your account password — GitHub and GHCR reject passwords.

RINKDESK_GITHUB_TOKEN=ghp_replace_me

# Optional. Defaults to the package owner (maciejhubisz).
# RINKDESK_REGISTRY_USER=MaciejHubisz

# Optional overrides.
# RINKDESK_REGISTRY=ghcr.io
# Persistent auth file (podman default: ~/.config/containers/auth.json).
# RINKDESK_AUTHFILE=/home/maciej/.config/containers/auth.json

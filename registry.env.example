# Private image registry credentials for ghcr.io.
#
# Copy to registry.env (gitignored) and fill in. Read by ./start.sh --login and
# by scripts/setup-server-as-root.sh, so a fresh host pulls the private images
# with no prompts.
#
#   cp registry.env.example registry.env
#   chmod 600 registry.env
#
# Create a classic token with the read:packages scope in a browser
# (GitHub → Settings → Developer settings → Personal access tokens). It is a
# token, not your account password — GHCR rejects passwords.

RINKDESK_REGISTRY_USER=MaciejHubisz
RINKDESK_REGISTRY_TOKEN=ghp_replace_me

# Optional overrides.
# RINKDESK_REGISTRY=ghcr.io
# Persistent auth file (podman default: ~/.config/containers/auth.json).
# RINKDESK_AUTHFILE=/home/maciej/.config/containers/auth.json

# RinkDesk public site. Served by nginx in front of the desk.
#
# The setup script substitutes __DOMAIN__ and __PORT__ from scripts/admin/admin.env.
# Only the live page is exposed; everything else returns 404.
#
# This is the HTTP-only block. When TLS is enabled, certbot --nginx adds the
# listen 443 / ssl_* lines and the port 80 -> 443 redirect to the installed copy.
server {
    listen 80;
    server_name __DOMAIN__;

    location = / {
        return 301 /live/;
    }

    location /live {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 404;
    }
}
